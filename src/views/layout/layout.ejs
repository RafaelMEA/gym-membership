<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · ARMZTRONG GYM</title>
  <link rel="icon" type="image/jpeg" href="/assets/logo.jpeg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body class="min-h-screen bg-ink font-sans text-zinc-300 antialiased">
  <a href="#main-content"
     class="sr-only z-[70] rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:outline-none focus:ring-2 focus:ring-white/60">
    Skip to content
  </a>
  <%- include('header.ejs') %>

  <main id="main-content" tabindex="-1" class="md:pl-64 focus:outline-none">
    <div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex-1">
        <%- body %>
      </div>
      <%- include('footer.ejs') %>
    </div>
  </main>

  <%- include('toast.ejs') %>
</body>
</html>
