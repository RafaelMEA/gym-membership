<section class="mx-auto flex min-h-[60vh] max-w-xl flex-col justify-center py-10">
  <div class="rounded-xl border border-line bg-panel p-6 sm:p-8">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-600/15 text-brand-400 ring-1 ring-brand-600/40">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true" focusable="false">
        <path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/>
      </svg>
    </span>

    <h1 class="mt-5 font-display text-3xl tracking-wide text-white sm:text-4xl"><%= heading %></h1>
    <p class="mt-3 text-sm leading-relaxed text-zinc-400"><%= message %></p>

    <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
      <a href="/" class="btn btn-primary">Back to dashboard</a>
      <button type="button" onclick="window.location.reload()" class="btn btn-secondary">Try again</button>
    </div>

    <p class="mt-4 break-words text-[11px] text-faint">
      Reference: <%= code %> · <%= url %>
    </p>
  </div>
</section>
