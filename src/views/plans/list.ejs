<!-- Page head -->
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-display text-4xl tracking-wide text-white">Plans</h1>
    <p class="mt-1 text-sm text-zinc-500">Price and duration used when creating subscriptions.</p>
  </div>
  <button type="button" data-add-plan
          class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500">
    + Add plan
  </button>
</div>

<% if (toast) { %>
  <div data-toast class="mt-5 rounded-lg border px-4 py-3 text-sm <%= toast.kind === 'success' ? 'border-emerald-600/40 bg-emerald-500/10 text-emerald-300' : 'border-brand-700/50 bg-brand-600/10 text-brand-400' %>">
    <%= toast.text %>
  </div>
<% } %>

<% if (plans.length === 0) { %>
  <section class="mt-6 rounded-xl border border-line bg-panel px-6 py-14 text-center">
    <p class="font-display text-2xl text-white">No plans yet</p>
    <p class="mt-1 text-sm text-zinc-500">Add a plan before creating subscriptions.</p>
  </section>
<% } else { %>
  <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% plans.forEach((p) => { %>
      <article class="flex flex-col rounded-xl border border-line bg-panel p-5">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="truncate font-display text-xl tracking-wide text-white"><%= p.name %></h2>
            <p class="mt-0.5 text-xs text-zinc-500">
              <%= p.duration %> · <%= p.maxVisits === null ? 'Unlimited visits' : `${p.maxVisits} visits / period` %>
            </p>
          </div>
          <p class="shrink-0 font-display text-2xl text-brand-500"><%= p.price %></p>
        </div>

        <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400"><%= p.description ?? '' %></p>

        <div class="mt-4 flex items-center justify-between border-t border-line pt-3">
          <span class="text-xs text-zinc-600"><%= p.usage %> subscription<%= p.usage === 1 ? '' : 's' %></span>
          <div class="flex items-center gap-3">
            <button type="button"
                    data-edit-plan
                    data-id="<%= p.id %>"
                    data-name="<%= p.name %>"
                    data-description="<%= p.description ?? '' %>"
                    data-price="<%= p.priceRaw %>"
                    data-duration-value="<%= p.durationValue %>"
                    data-duration-unit="<%= p.durationUnit %>"
                    data-max-visits="<%= p.maxVisits ?? '' %>"
                    class="text-xs font-medium text-brand-400 transition-colors hover:text-brand-500">
              Edit
            </button>
            <% if (staff.role === 'admin') { %>
              <form method="post" action="/plans/<%= p.id %>/remove"
                    onsubmit="return confirm('Deactivate this plan?\nExisting subscriptions keep their dates; it can no longer be chosen for new ones.')">
                <button type="submit" class="text-xs font-medium text-zinc-600 transition-colors hover:text-zinc-400">Deactivate</button>
              </form>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </section>
  <p class="mt-6 text-[11px] leading-relaxed text-zinc-600">
    Front desk rates for reference: ₱50 per session · ₱450/month students · ₱550/month regular.
  </p>
<% } %>

<%- include('form.ejs') %>

<script>
  // One modal serves both create and edit. Edit prefills from data
  // attributes; server-side validation errors re-render the modal open
  // with the submitted values, so JS only handles the happy path.
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('plan-form-modal')
    if (!modal) return
    const formEl = modal.querySelector('form')
    const title = modal.querySelector('[data-plan-form-title]')
    const field = (n) => formEl.querySelector('[name="' + n + '"]')

    const useCreateMode = () => {
      formEl.reset()
      formEl.action = '/plans'
      title.textContent = 'Add plan'
    }

    document.querySelectorAll('[data-add-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        useCreateMode()
        openModal(modal)
      })
    })

    document.querySelectorAll('[data-edit-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = btn.dataset
        formEl.action = '/plans/' + d.id
        title.textContent = 'Edit plan'
        field('name').value = d.name
        field('description').value = d.description
        field('price').value = d.price
        field('duration_value').value = d.durationValue
        field('duration_unit').value = d.durationUnit
        field('max_visits_per_period').value = d.maxVisits
        openModal(modal)
      })
    })
  })
</script>
