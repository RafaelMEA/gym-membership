<!-- Page head -->
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-display text-4xl tracking-wide text-white">Members</h1>
    <p class="mt-1 text-sm text-zinc-500">
      <%= q ? `${members.length} of ${totalCount} members` : `${totalCount} member${totalCount === 1 ? '' : 's'} on file` %>
    </p>
  </div>
  <button type="button" data-open-modal="#member-form-modal"
          class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500">
    + Add member
  </button>
</div>

<% if (toast) { %>
  <div data-toast class="mt-5 rounded-lg border px-4 py-3 text-sm <%= toast.kind === 'success' ? 'border-emerald-600/40 bg-emerald-500/10 text-emerald-300' : 'border-brand-700/50 bg-brand-600/10 text-brand-400' %>">
    <%= toast.text %>
  </div>
<% } %>

<!-- Search -->
<form method="get" action="/members" class="mt-6 flex max-w-lg gap-2">
  <input type="search" name="q" value="<%= q %>" placeholder="Search name, email or membership no…"
         class="w-full rounded-lg border border-line bg-panel px-3.5 py-2.5 text-sm text-white placeholder-zinc-600 outline-none transition focus:border-brand-600 focus:ring-2 focus:ring-brand-600/30">
  <button type="submit" class="rounded-lg border border-line bg-panel-2 px-4 text-sm font-medium text-zinc-300 transition-colors hover:border-brand-600/60 hover:text-white">Search</button>
  <% if (q) { %>
    <a href="/members" class="px-3 py-2.5 text-sm text-zinc-500 transition-colors hover:text-zinc-300">Clear</a>
  <% } %>
</form>

<!-- Table -->
<section class="mt-4 overflow-hidden rounded-xl border border-line bg-panel">
  <% if (members.length === 0) { %>
    <div class="px-6 py-14 text-center">
      <p class="font-display text-2xl text-white"><%= q ? 'No members match your search' : 'No members yet' %></p>
      <p class="mt-1 text-sm text-zinc-500">
        <%= q ? 'Try a different name, email or membership number.' : 'Add your first member to get started.' %>
      </p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-zinc-600">
            <th class="px-5 py-3 font-semibold">Member</th>
            <th class="px-5 py-3 font-semibold">Membership no.</th>
            <th class="hidden px-5 py-3 font-semibold sm:table-cell">Email</th>
            <th class="hidden px-5 py-3 font-semibold lg:table-cell">Phone</th>
            <th class="px-5 py-3 text-right font-semibold"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% members.forEach((m) => { %>
            <tr class="transition-colors hover:bg-panel-2/60">
              <td class="px-5 py-3">
                <a href="/members/<%= m.id %>" class="flex items-center gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600/15 text-xs font-semibold text-brand-400"><%= m.initials %></span>
                  <span class="font-medium text-zinc-200"><%= m.name %></span>
                </a>
              </td>
              <td class="px-5 py-3 text-zinc-500"><%= m.membershipNo %></td>
              <td class="hidden px-5 py-3 text-zinc-400 sm:table-cell"><%= m.email %></td>
              <td class="hidden px-5 py-3 text-zinc-400 lg:table-cell"><%= m.phone ?? '—' %></td>
              <td class="px-5 py-3 text-right">
                <a href="/members/<%= m.id %>" class="text-xs font-medium text-brand-400 transition-colors hover:text-brand-500">View →</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('form.ejs') %>
