<!-- Page head -->
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-display text-4xl tracking-wide text-white">Dashboard</h1>
    <p class="mt-1 text-sm text-zinc-500"><%= todayLabel %> · ARMZTRONG GYM, General Luna Branch</p>
  </div>
  <p class="text-xs text-zinc-600">Signed in as <span class="text-zinc-400"><%= staff.full_name %></span></p>
</div>

<!-- Stat cards -->
<div class="mt-6 grid grid-cols-2 gap-4 xl:grid-cols-4">
  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Total members</p>
    <p class="mt-2 font-display text-4xl text-white"><%= stats.totalMembers %></p>
    <p class="mt-1 text-xs text-zinc-600">Active member records</p>
  </div>

  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Active subs</p>
    <p class="mt-2 font-display text-4xl text-brand-500"><%= stats.activeSubs %></p>
    <p class="mt-1 text-xs text-zinc-600">Running right now</p>
  </div>

  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">In gym now</p>
    <p class="mt-2 font-display text-4xl text-white"><%= stats.inGymNow %></p>
    <p class="mt-1 text-xs text-zinc-600">Open visits, not checked out</p>
  </div>

  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Today's check-ins</p>
    <p class="mt-2 font-display text-4xl text-white"><%= stats.todayVisits %></p>
    <p class="mt-1 text-xs text-zinc-600">Visits logged today</p>
  </div>
</div>

<!-- Revenue banner -->
<div class="mt-4 flex items-center justify-between gap-4 rounded-xl border border-line bg-gradient-to-r from-brand-600/15 via-panel to-panel p-5">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Revenue this month</p>
    <p class="mt-1 font-display text-3xl text-white"><%= monthRevenue %></p>
  </div>
  <p class="hidden max-w-xs text-xs text-zinc-600 sm:block">Paid payments with a database timestamp inside the current month.</p>
</div>

<!-- Main grid -->
<div class="mt-6 grid gap-6 lg:grid-cols-3">

  <!-- Today's check-ins -->
  <section class="rounded-xl border border-line bg-panel lg:col-span-2">
    <header class="flex items-center justify-between border-b border-line px-5 py-4">
      <h2 class="font-display text-xl tracking-wide text-white">Today's check-ins</h2>
      <span class="text-xs text-zinc-600"><%= stats.todayVisits %> <%= stats.todayVisits === 1 ? 'visit' : 'visits' %></span>
    </header>

    <% if (checkIns.length === 0) { %>
      <div class="px-5 py-10 text-center">
        <p class="text-sm text-zinc-500">No check-ins yet today.</p>
        <p class="mt-1 text-xs text-zinc-600">Check-in and check-out tools arrive with the attendance page.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-zinc-600">
              <th class="px-5 py-3 font-semibold">Member</th>
              <th class="px-5 py-3 font-semibold">Membership no.</th>
              <th class="px-5 py-3 font-semibold">Check-in</th>
              <th class="px-5 py-3 font-semibold">Check-out</th>
              <th class="px-5 py-3 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% checkIns.forEach((c) => { %>
              <tr class="transition-colors hover:bg-panel-2/60">
                <td class="px-5 py-3 text-zinc-200"><%= c.memberName %></td>
                <td class="px-5 py-3 text-zinc-500"><%= c.membershipNo %></td>
                <td class="px-5 py-3 text-zinc-400"><%= c.checkIn %></td>
                <td class="px-5 py-3 text-zinc-400"><%= c.checkOut ?? '—' %></td>
                <td class="px-5 py-3">
                  <% if (c.open) { %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-600/15 px-2.5 py-1 text-[11px] font-semibold text-brand-400 ring-1 ring-brand-600/40">
                      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-brand-500"></span>
                      IN GYM
                    </span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-zinc-800 px-2.5 py-1 text-[11px] font-semibold text-zinc-400">DONE</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <!-- Right column -->
  <div class="space-y-6">

    <!-- Expiring soon -->
    <section class="rounded-xl border border-line bg-panel">
      <header class="border-b border-line px-5 py-4">
        <h2 class="font-display text-xl tracking-wide text-white">Expiring soon</h2>
        <p class="mt-0.5 text-xs text-zinc-600">Active subscriptions ending within 7 days</p>
      </header>

      <% if (expiring.length === 0) { %>
        <p class="px-5 py-8 text-center text-sm text-zinc-500">Nothing expiring in the next 7 days.</p>
      <% } else { %>
        <ul class="divide-y divide-line">
          <% expiring.forEach((e) => { %>
            <li class="flex items-center justify-between gap-3 px-5 py-3.5">
              <div class="min-w-0">
                <p class="truncate text-sm text-zinc-200"><%= e.memberName %></p>
                <p class="text-xs text-zinc-600"><%= e.planName %> · ends <%= e.endDate %></p>
              </div>
              <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold
                           <%= e.daysLeft <= 2
                                 ? 'bg-brand-600/15 text-brand-400 ring-1 ring-brand-600/40'
                                 : 'bg-zinc-800 text-zinc-400' %>">
                <%= e.daysLeft %>d left
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <!-- Quick actions (pages coming later) -->
    <section class="rounded-xl border border-line bg-panel p-5">
      <h2 class="font-display text-xl tracking-wide text-white">Quick actions</h2>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <button disabled title="Coming soon"
                class="cursor-not-allowed rounded-lg border border-line bg-panel-2 px-3 py-2.5 text-left text-sm text-zinc-500">
          Check-in member <span class="ml-1 text-[10px] text-zinc-600">SOON</span>
        </button>
        <button disabled title="Coming soon"
                class="cursor-not-allowed rounded-lg border border-line bg-panel-2 px-3 py-2.5 text-left text-sm text-zinc-500">
          Add member <span class="ml-1 text-[10px] text-zinc-600">SOON</span>
        </button>
        <button disabled title="Coming soon"
                class="cursor-not-allowed rounded-lg border border-line bg-panel-2 px-3 py-2.5 text-left text-sm text-zinc-500">
          New subscription <span class="ml-1 text-[10px] text-zinc-600">SOON</span>
        </button>
        <button disabled title="Coming soon"
                class="cursor-not-allowed rounded-lg border border-line bg-panel-2 px-3 py-2.5 text-left text-sm text-zinc-500">
          Record payment <span class="ml-1 text-[10px] text-zinc-600">SOON</span>
        </button>
      </div>
    </section>

    <!-- Gym info card (photos + copy from information.json) -->
    <section class="overflow-hidden rounded-xl border border-line bg-panel">
      <img src="/assets/map_and_directions_to_gym.jpg" alt="Directions to ARMZTRONG GYM" class="h-36 w-full object-cover">
      <div class="p-5">
        <h2 class="font-display text-xl tracking-wide text-white">ARMZTRONG GYM</h2>
        <p class="mt-1 text-xs text-zinc-500">Lower General Luna Road (below Mang Inasal)</p>
        <ul class="mt-3 space-y-1.5 text-xs text-zinc-400">
          <li>· ₱50 per session</li>
          <li>· ₱450 / month for students · ₱550 regular</li>
        </ul>
      </div>
    </section>

  </div>
</div>
