<!-- Page head -->
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-display text-4xl tracking-wide text-white">Attendance</h1>
    <p class="mt-1 text-sm text-zinc-500"><%= todayLabel %> · Front desk check-in and check-out</p>
  </div>
  <a href="/members"
     class="rounded-lg border border-line bg-panel px-4 py-2.5 text-sm font-medium text-zinc-300 transition-colors hover:border-brand-600/60 hover:text-white">
    Member directory →
  </a>
</div>

<!-- Stats -->
<div class="mt-6 grid grid-cols-3 gap-4">
  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">In gym now</p>
    <p class="mt-2 font-display text-4xl text-brand-500"><%= stats.inGym %></p>
    <p class="mt-1 hidden text-xs text-zinc-600 sm:block">Open visits</p>
  </div>
  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Today's visits</p>
    <p class="mt-2 font-display text-4xl text-white"><%= stats.todayVisits %></p>
    <p class="mt-1 hidden text-xs text-zinc-600 sm:block">Checked in today</p>
  </div>
  <div class="rounded-xl border border-line bg-panel p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Active members</p>
    <p class="mt-2 font-display text-4xl text-white"><%= stats.eligible %></p>
    <p class="mt-1 hidden text-xs text-zinc-600 sm:block">With a running sub</p>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">

  <!-- Check-in directory -->
  <section class="overflow-hidden rounded-xl border border-line bg-panel lg:col-span-2">
    <header class="flex items-center justify-between gap-3 border-b border-line px-5 py-4">
      <div>
        <h2 class="font-display text-xl tracking-wide text-white">Check in</h2>
        <p class="mt-0.5 text-xs text-zinc-600">Members with a running subscription can be checked in.</p>
      </div>
      <span id="directory-count" data-live-sync aria-live="polite" class="shrink-0 text-xs text-zinc-600"><%= directory.length %> shown</span>
    </header>

    <form method="get" action="/attendance" data-live-search class="flex gap-2 border-b border-line px-5 py-3">
      <input type="search" name="q" value="<%= q %>" placeholder="Search name or membership no…"
             autocomplete="off" spellcheck="false"
             class="w-full rounded-lg border border-line bg-panel-2 px-3.5 py-2 text-sm text-white placeholder-zinc-600 outline-none transition focus:border-brand-600 focus:ring-2 focus:ring-brand-600/30">
      <button type="submit" class="rounded-lg border border-line bg-panel-2 px-4 text-sm font-medium text-zinc-300 transition-colors hover:border-brand-600/60 hover:text-white disabled:cursor-not-allowed disabled:opacity-50">Search</button>
      <a href="/attendance" data-live-clear class="btn btn-secondary<%= q ? '' : ' hidden' %>">Clear</a>
    </form>

    <div id="directory-results" data-live-results aria-busy="false">
    <% if (directory.length === 0) { %>
      <div class="px-6 py-14 text-center">
        <p class="font-display text-2xl text-white"><%= q ? 'No members match your search' : 'No members yet' %></p>
        <p class="mt-1 text-sm text-zinc-500">
          <%= q ? 'Try a different name or membership number.' : 'Add members before using the front desk.' %>
        </p>
      </div>
    <% } else { %>
      <ul class="divide-y divide-line">
        <% directory.forEach((m) => { %>
          <li class="flex items-center gap-3 px-5 py-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600/15 text-xs font-semibold text-brand-400"><%= m.initials %></span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <a href="/members/<%= m.id %>" class="truncate text-sm font-medium text-zinc-200 transition-colors hover:text-brand-400"><%= m.name %></a>
                <span class="text-[11px] text-zinc-600"><%= m.membershipNo %></span>
              </div>
              <% if (m.planName) { %>
                <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1.5">
                  <span class="min-w-0 truncate text-xs text-zinc-500"><%= m.planName %></span>
                  <span class="inline-flex shrink-0 whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] font-medium
                               <%= m.daysLeft <= 2
                                     ? 'bg-brand-600/15 text-brand-400 ring-1 ring-brand-600/40'
                                     : 'bg-zinc-800 text-zinc-400' %>">
                    <%= m.daysLeft %> day<%= m.daysLeft === 1 ? '' : 's' %> left
                  </span>
                </div>
              <% } else { %>
                <p class="mt-1 text-xs text-zinc-600">No active subscription</p>
              <% } %>
            </div>

            <div class="shrink-0">
              <% if (m.canCheckIn) { %>
                <form method="post" action="/attendance/check-in">
                  <input type="hidden" name="member_id" value="<%= m.id %>">
                  <button type="submit"
                          class="rounded-lg bg-brand-600 px-3.5 py-2 text-xs font-semibold text-white transition-colors hover:bg-brand-500">
                    Check in
                  </button>
                </form>
              <% } else if (m.inGymSince) { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-400 ring-1 ring-emerald-500/40">
                  <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                  Since <%= m.inGymSince %>
                </span>
              <% } else { %>
                <a href="/members/<%= m.id %>" class="btn btn-secondary btn-sm">View</a>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
    </div>
  </section>

  <!-- Right column -->
  <div class="space-y-6">

    <!-- In the gym now -->
    <section class="rounded-xl border border-line bg-panel">
      <header class="flex items-center justify-between gap-3 border-b border-line px-5 py-4">
        <h2 class="font-display text-xl tracking-wide text-white">In the gym now</h2>
        <span class="flex items-center gap-1.5 text-xs text-zinc-500">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <%= stats.inGym %> inside
        </span>
      </header>

      <% if (inGym.length === 0) { %>
        <div class="px-5 py-10 text-center">
          <p class="text-sm text-zinc-500">Nobody is checked in right now.</p>
          <p class="mt-1 text-xs text-zinc-600">Check someone in from the list to start a visit.</p>
        </div>
      <% } else { %>
        <ul class="divide-y divide-line">
          <% inGym.forEach((g) => { %>
            <li class="flex items-center justify-between gap-3 px-5 py-3.5">
              <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-[11px] font-semibold text-emerald-400"><%= g.initials %></span>
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-zinc-200"><%= g.name %></p>
                  <p class="text-xs text-zinc-600">Since <%= g.since %> · <%= g.elapsed %></p>
                </div>
              </div>
              <form method="post" action="/attendance/check-out">
                <input type="hidden" name="member_id" value="<%= g.memberId %>">
                <button type="submit"
                        class="rounded-lg border border-line px-3 py-1.5 text-xs font-medium text-zinc-300 transition-colors hover:border-brand-600/60 hover:text-white">
                  Check out
                </button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <!-- Rates card -->
    <section class="overflow-hidden rounded-xl border border-line bg-panel">
      <img src="/assets/pic2.jpg" alt="Inside ARMZTRONG GYM — equipment and workout area" class="h-36 w-full object-cover">
      <div class="p-5">
        <h2 class="font-display text-xl tracking-wide text-white">Drop-in &amp; membership rates</h2>
        <ul class="mt-3 space-y-1.5 text-xs text-zinc-400">
          <li class="flex justify-between border-b border-line/60 pb-1.5"><span>Per session</span><span class="text-zinc-200">₱50</span></li>
          <li class="flex justify-between border-b border-line/60 pb-1.5"><span>Monthly · student</span><span class="text-zinc-200">₱450</span></li>
          <li class="flex justify-between"><span>Monthly · regular</span><span class="text-zinc-200">₱550</span></li>
        </ul>
        <p class="mt-3 text-[11px] leading-relaxed text-zinc-600">
          Walk-ins pay per session at the desk. A running subscription is required for member check-in.
        </p>
      </div>
    </section>

  </div>
</div>

<!-- Today's activity -->
<section class="mt-6 overflow-hidden rounded-xl border border-line bg-panel">
  <header class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
    <div>
      <h2 class="font-display text-xl tracking-wide text-white">Today's activity</h2>
      <p class="mt-0.5 text-xs text-zinc-600"><%= todayLabel %> · every visit logged at the front desk</p>
    </div>
    <span class="text-xs text-zinc-600"><%= stats.todayVisits %> <%= stats.todayVisits === 1 ? 'visit' : 'visits' %></span>
  </header>

  <% if (todayVisits.length === 0) { %>
    <div class="px-6 py-12 text-center">
      <p class="text-sm text-zinc-500">No visits today yet.</p>
      <p class="mt-1 text-xs text-zinc-600">Check-ins will appear here as they happen.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-zinc-600">
            <th class="px-5 py-3 font-semibold">Member</th>
            <th class="px-5 py-3 font-semibold">Check-in</th>
            <th class="px-5 py-3 font-semibold">Check-out</th>
            <th class="hidden px-5 py-3 font-semibold sm:table-cell">Duration</th>
            <th class="px-5 py-3 font-semibold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% todayVisits.forEach((v) => { %>
            <tr class="transition-colors hover:bg-panel-2/60">
              <td class="px-5 py-3 text-zinc-200"><%= v.name %></td>
              <td class="px-5 py-3 text-zinc-400"><%= v.checkIn %></td>
              <td class="px-5 py-3 text-zinc-400"><%= v.checkOut ?? '—' %></td>
              <td class="hidden px-5 py-3 text-zinc-500 sm:table-cell"><%= v.duration ?? '—' %></td>
              <td class="px-5 py-3">
                <% if (v.open) { %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-400 ring-1 ring-emerald-500/40">
                    <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                    IN GYM
                  </span>
                <% } else { %>
                  <span class="inline-flex rounded-full bg-zinc-800 px-2.5 py-1 text-[11px] font-semibold text-zinc-400">DONE</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
