<%
  // Payments forms:
  //  1. record-payment modal (server-driven FormState)
  //  2. refund modal (static skeleton; JS sets the action + label)
  const labelCls = 'block text-xs font-semibold uppercase tracking-wider text-zinc-400'
  const inputCls = 'mt-1.5 w-full rounded-lg border bg-panel px-3.5 py-2.5 text-sm text-white placeholder-zinc-600 outline-none transition focus:border-brand-600 focus:ring-2 focus:ring-brand-600/30'
%>

<!-- Record payment -->
<div id="payment-form-modal" data-modal class="fixed inset-0 z-50 <%= form.open ? 'flex' : 'hidden' %> items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-close-modal></div>

  <div class="relative w-full max-w-lg rounded-2xl border border-line bg-panel shadow-2xl">
    <header class="flex items-start justify-between border-b border-line px-6 py-4">
      <div>
        <h2 class="font-display text-2xl tracking-wide text-white">Record payment</h2>
        <p class="mt-0.5 text-xs text-zinc-500"><%= form.subtitle %></p>
      </div>
      <button type="button" data-close-modal aria-label="Close"
              class="rounded-lg p-1.5 text-zinc-500 transition-colors hover:bg-panel-2 hover:text-zinc-300">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <form method="post" action="<%= form.action %>" class="max-h-[70vh] overflow-y-auto px-6 py-5">
      <% if (form.message) { %>
        <div class="mb-4 rounded-lg border border-brand-700/50 bg-brand-600/10 px-4 py-3 text-sm text-brand-400" role="alert">
          <%= form.message %>
        </div>
      <% } %>

      <div>
        <label for="pay-sub" class="<%= labelCls %>">Subscription</label>
        <select id="pay-sub" name="subscription_id" required
                class="<%= inputCls %> <%= form.fieldErrors.subscription_id ? 'border-brand-600' : 'border-line' %>">
          <option value="" <%= form.values.subscription_id === '' ? 'selected' : '' %> disabled>Select a subscription…</option>
          <% formOptions.subscriptions.forEach((s) => { %>
            <option value="<%= s.id %>" data-price="<%= s.price %>" <%= form.values.subscription_id === String(s.id) ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
        <% if (form.fieldErrors.subscription_id) { %>
          <p class="mt-1 text-xs text-brand-400"><%= form.fieldErrors.subscription_id %></p>
        <% } %>
        <p class="mt-1 text-xs text-zinc-600">Only active and frozen subscriptions are listed.</p>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="pay-amount" class="<%= labelCls %>">Amount (₱)</label>
          <input id="pay-amount" name="amount" type="number" min="0.01" step="0.01" value="<%= form.values.amount %>" required placeholder="550.00"
                 class="<%= inputCls %> <%= form.fieldErrors.amount ? 'border-brand-600' : 'border-line' %>">
          <% if (form.fieldErrors.amount) { %>
            <p class="mt-1 text-xs text-brand-400"><%= form.fieldErrors.amount %></p>
          <% } %>
        </div>

        <div>
          <label for="pay-method" class="<%= labelCls %>">Method</label>
          <select id="pay-method" name="method" class="<%= inputCls %> border-line">
            <% ['cash', 'card', 'transfer', 'online'].forEach((m) => { %>
              <option value="<%= m %>" <%= form.values.method === m ? 'selected' : '' %>><%= m.charAt(0).toUpperCase() + m.slice(1) %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="pay-status" class="<%= labelCls %>">Status</label>
          <select id="pay-status" name="status" class="<%= inputCls %> border-line">
            <% ['paid', 'pending', 'failed'].forEach((s) => { %>
              <option value="<%= s %>" <%= form.values.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="pay-date" class="<%= labelCls %>">Paid on <span class="normal-case text-zinc-600">optional</span></label>
          <input id="pay-date" name="paid_at" type="date" value="<%= form.values.paid_at %>"
                 class="<%= inputCls %> <%= form.fieldErrors.paid_at ? 'border-brand-600' : 'border-line' %>">
          <% if (form.fieldErrors.paid_at) { %>
            <p class="mt-1 text-xs text-brand-400"><%= form.fieldErrors.paid_at %></p>
          <% } %>
        </div>
      </div>

      <div class="mt-4">
        <label for="pay-notes" class="<%= labelCls %>">Notes <span class="normal-case text-zinc-600">optional</span></label>
        <textarea id="pay-notes" name="notes" rows="2" placeholder="e.g. renewal + 1 free session"
                  class="<%= inputCls %> <%= form.fieldErrors.notes ? 'border-brand-600' : 'border-line' %>"><%= form.values.notes %></textarea>
        <% if (form.fieldErrors.notes) { %>
          <p class="mt-1 text-xs text-brand-400"><%= form.fieldErrors.notes %></p>
        <% } %>
      </div>

      <p class="mt-3 text-[11px] leading-relaxed text-zinc-600">
        Leave the date blank to stamp it with the current database time. A non-paid status clears it.
      </p>

      <div class="mt-6 flex justify-end gap-2 border-t border-line pt-4">
        <button type="button" data-close-modal
                class="btn btn-secondary">Cancel</button>
        <button type="submit"
                class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500">
          <%= form.submitLabel %>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Refund confirmation -->
<div id="refund-form-modal" data-modal class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" data-close-modal></div>

  <div class="relative w-full max-w-md rounded-2xl border border-line bg-panel shadow-2xl">
    <header class="border-b border-line px-6 py-4">
      <h2 class="font-display text-2xl tracking-wide text-white">Refund payment</h2>
      <p class="mt-0.5 text-xs text-zinc-500">The payment stays on record, marked as refunded.</p>
    </header>

    <form method="post" action="" class="px-6 py-5">
      <p class="rounded-lg border border-line bg-panel-2 px-4 py-3 text-sm text-zinc-300" data-refund-label>—</p>

      <div class="mt-4">
        <label for="refund-notes" class="<%= labelCls %>">Reason <span class="normal-case text-zinc-600">optional</span></label>
        <textarea id="refund-notes" name="notes" rows="2" placeholder="Why is this being refunded?"
                  class="<%= inputCls %> border-line"></textarea>
      </div>

      <div class="mt-6 flex justify-end gap-2 border-t border-line pt-4">
        <button type="button" data-close-modal
                class="btn btn-secondary">Cancel</button>
        <button type="submit"
                class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500">
          Refund
        </button>
      </div>
    </form>
  </div>
</div>
